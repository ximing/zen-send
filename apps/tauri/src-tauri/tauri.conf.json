{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zen Send",
  "version": "1.0.11",
  "identifier": "com.zensend.app",
  "build": {
    "beforeDevCommand": "node scripts/before-dev.mjs",
    "devUrl": "http://localhost:5274",
    "frontendDist": "https://zs.aimo.plus"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Zen Send",
        "width": 1200,
        "height": 800,
        "minWidth": 460,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Cross-device content transfer",
    "longDescription": "Zen Send - Cross-platform clipboard, text, and file transfer tool",
    "copyright": "Copyright © 2026 Zen Send",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
